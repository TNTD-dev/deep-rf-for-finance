# Copy to .env and fill in. .env is gitignored.

# === OpenAI ===
OPENAI_API_KEY=sk-...
# Model lock — do NOT change without updating PRD §14 Risk #3.
# Cutoff Oct 2023 keeps test period (2025-05 → 2026-04) out-of-distribution.
LLM_MODEL_PRIMARY=gpt-4o
LLM_MODEL_MINI=gpt-4o-mini

# === Universe (VN30 subset) ===
TICKERS=VCB,FPT,HPG,VIC,VNM

# === Period boundaries (PRD §15 — locked) ===
TRAIN_START=2019-01-01
VAL_START=2025-01-01
TEST_START=2025-05-01
TEST_END=2026-04-30

# === Capital + fees (VND) ===
INITIAL_CAPITAL=1000000000
BUY_FEE=0.0015
SELL_FEE=0.0025

# === HOSE market rules ===
PRICE_BAND=0.07
LOT_SIZE=100
